{
  "name": "inventario-casa",
  "private": true,
  "type": "module",
  "description": "Inventario de casa: PWA para la comida no perecedera",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "servir": "npm run vendor && node scripts/serve.mjs",
    "construir": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:unit": "npm run vendor",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "pretest:e2e": "npm run vendor",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "htm": "3.1.1",
    "preact": "10.29.8"
  }
}
